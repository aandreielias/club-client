# mock = in-browser fake API and dev login (no services needed); http = real club-server + Supabase.
VITE_API_MODE=mock

# Only for VITE_API_MODE=http
VITE_API_URL=https://api.example.at
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_…), never the secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=
